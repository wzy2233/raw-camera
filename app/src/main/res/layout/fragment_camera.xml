<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 相机预览（GPU加速） -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintBottom_toTopOf="@+id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 滤镜预览覆盖层（内置滤镜用） -->
    <ImageView
        android:id="@+id/filterPreviewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 白平衡校准时的取样框（中间 50%，和采样算法一致） -->
    <View
        android:id="@+id/calibFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/calib_frame"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
        app:layout_constraintEnd_toEndOf="@+id/viewFinder"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintStart_toStartOf="@+id/viewFinder"
        app:layout_constraintTop_toTopOf="@+id/viewFinder"
        app:layout_constraintWidth_percent="0.4" />

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/galleryButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="图库"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gallery" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/captureButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="快门"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shutter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/filterButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="滤镜"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_filter" />

            <ImageButton
                android:id="@+id/switchCameraButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="切换摄像头"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_switch_camera" />
        </LinearLayout>

    </LinearLayout>

    <!--
      顶部工具条。
      结构：外层胶囊 = [参数区(可压缩)] + [工具区(固定宽度)]。
      为什么必须拆开：原来所有东西塞在一个横向 LinearLayout 里，屏幕只有 361dp 宽，
      参数文字（RAW/AE/AWB/比例）加起来超过可用宽度后，LinearLayout 会把最后一个子项
      压到"剩余空间"——设置按钮被压成 8dp，图标区只剩 13px，看得见才怪。
      拆开后参数区用 weight 占满剩余空间，工具区固定 40dp，永远不会被文字挤掉。
    -->
    <LinearLayout
        android:id="@+id/ratioLayout"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_margin="6dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 参数区：内容超宽时由这一区让出空间，不影响右侧按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rawModeText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="RAW"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/aeLockText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="AE 自动"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/whiteBalanceText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="AWB 自动"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 比例：固定宽度，同样不参与压缩 -->
        <Spinner
            android:id="@+id/ratioSpinner"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 工具区：固定 40dp，靠右且不参与压缩 -->
        <ImageButton
            android:id="@+id/orientationButton"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="切换横竖方向"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_rotate" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="处理设置"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>